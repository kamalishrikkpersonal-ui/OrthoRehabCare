# ============================================================
# OrthoRehab AI backend — environment variables
# Copy this file to .env and fill in the values for local dev.
# NEVER commit the real .env (it is git-ignored).
# ============================================================

# Path to the therapist reference video used as the baseline for the
# Elbow Flexion / Extension exercise. On deployed platforms this should be a
# path to a packaged/stored reference video (see README deployment notes).
DEFAULT_REFERENCE_VIDEO=../REFERENCE VIDEOS/reference_video.mp4

# Comma-separated list of allowed frontend origins (CORS).
# Include your deployed Vercel/Netlify URL here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Groq LLM API key. If unset, the backend uses deterministic
# fallback feedback ("Movement Guidance"). The key NEVER ships in the frontend.
GROQ_API_KEY=
